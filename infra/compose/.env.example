# Copie a .env (ignorado por git) y CAMBIE todos los valores. Solo para desarrollo local.
POSTGRES_DB=fitcore
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=cambie-esta-clave
# Puerto del host para PostgreSQL (cambielo si 5432 esta ocupado)
POSTGRES_PORT=5432
# Contrasena del rol fitcore_app (el que usan API y Worker; sin privilegios de superusuario)
APP_DB_PASSWORD=cambie-esta-clave-app
# Clave de firma JWT: minimo 32 caracteres, aleatoria
JWT_SIGNING_KEY=cambie-esta-clave-jwt-de-al-menos-32-caracteres
# Administrador de plataforma (se crea al arrancar si no existe). Contrasena: 10+ caracteres con mayuscula, minuscula y numero
PLATFORM_ADMIN_EMAIL=admin@fitcore.local
PLATFORM_ADMIN_PASSWORD=Cambie-Esta-Clave-1
