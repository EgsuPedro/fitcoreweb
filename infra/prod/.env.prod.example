# Copie este archivo a .env.prod (NO se sube a git) y complete TODOS los valores.
# Genere claves aleatorias con:  openssl rand -hex 24      (una distinta para cada una)

# Dominio público de la demo, sin https:// (por ejemplo: fit360-demo.duckdns.org). Para probar en su PC use: localhost
DOMAIN=

POSTGRES_DB=fitcore
POSTGRES_USER=fitcore
# Contraseña del propietario de la base (solo la usa el paso de migración y las copias de seguridad)
POSTGRES_PASSWORD=
# Contraseña del rol limitado fitcore_app (el que usan la API y el Worker)
APP_DB_PASSWORD=
# Clave de firma de las sesiones: mínimo 32 caracteres, aleatoria. Si se cambia, todas las sesiones se cierran.
JWT_SIGNING_KEY=

# Administrador de plataforma (se crea la primera vez). Contraseña: 10+ caracteres con mayúscula, minúscula y número
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Intentos de inicio de sesión por minuto y por IP
LOGIN_RATE_LIMIT=20

# Proveedor de pagos (opcional): sin secreto no hay proveedor y todo pago se registra a mano. Mínimo 16 caracteres.
PAYMENT_PROVIDER_CODE=webhook
PAYMENT_WEBHOOK_SECRET=

# Copias de seguridad: cuántos días se conservan y a qué hora UTC corre la diaria (7 UTC = 2:00 en Ecuador)
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=7

# Solo para probar el paquete en su PC (los puertos 80/443 suelen estar ocupados): HTTP_PORT=8088 HTTPS_PORT=8443 y DOMAIN=localhost
# En el servidor no se definen (usa 80 y 443).
